# ── AI Provider Keys ────────────────────────────────────────────────────────
# Set the key for whichever provider(s) you want to use.

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Anthropic / Claude  (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# ── Provider Defaults ────────────────────────────────────────────────────────
# Which provider to use when --provider is not specified.
# Choices: openai | claude | ollama
WHYCODE_DEFAULT_PROVIDER=ollama

# Model overrides (optional — sensible defaults are built-in)
WHYCODE_OPENAI_MODEL=gpt-4o
WHYCODE_CLAUDE_MODEL=claude-sonnet-4-20250514
WHYCODE_OLLAMA_MODEL=llama3

# Ollama base URL (change if you run Ollama on a remote host)
OLLAMA_BASE_URL=http://localhost:11434

# ── Cache ────────────────────────────────────────────────────────────────────
# Directory for the explanation cache (default: ~/.cache/whycode)
# WHYCODE_CACHE_DIR=/tmp/whycode_cache

# Cache TTL in seconds (default: 7 days = 604800)
# WHYCODE_CACHE_TTL=604800
